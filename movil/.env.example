# Dirección de la API que usa la app. El celular debe poder alcanzarla:
# - Pruebas en tu red: la IP de tu PC (ipconfig, "Dirección IPv4") y el puerto de la API.
#   API local (node dist/main.js): http://192.168.0.61:3000/api
#   Docker de pruebas (Caddy):     http://192.168.0.61:8080/api
# - Producción: la dirección pública del VPS, por ejemplo https://inventario.midominio.com/api
EXPO_PUBLIC_API_URL=http://192.168.0.61:3000/api
