# Caddy obtiene y renueva el certificado HTTPS automáticamente cuando DOMINIO es un dominio real.
{$DOMINIO::80} {
	encode gzip

	handle /api/* {
		reverse_proxy api:3000
	}

	# Web de administración (React). Las rutas internas regresan a index.html.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
