{
  "name": "inventario-api",
  "version": "1.0.0",
  "private": true,
  "description": "API del sistema de inventario de equipos",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "migracion:generar": "drizzle-kit generate",
    "migrar": "node dist/db/migrar.js",
    "seed": "node dist/db/seed.js",
    "pruebas:preparar": "npm run build && node --env-file=.env dist/db/migrar.js && node --env-file=.env dist/db/seed.js",
    "pruebas:iniciar": "node --env-file=.env dist/main.js"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/throttler": "^6.3.0",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "drizzle-orm": "0.45.3",
    "exceljs": "4.4.0",
    "helmet": "^8.0.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/multer": "1.4.12",
    "@types/node": "^20.17.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "typescript": "^5.6.3"
  }
}
