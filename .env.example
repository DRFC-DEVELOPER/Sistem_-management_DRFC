# Copia este archivo como .env y cambia todos los valores.
# Genera claves seguras con:  openssl rand -hex 32

# Dominio que apunta a tu VPS (registro A en el DNS). Sin dominio usa :80
DOMINIO=inventario.tuempresa.com

# Base de datos (usa solo letras y números en la contraseña)
POSTGRES_DB=inventario
POSTGRES_USER=inventario
POSTGRES_PASSWORD=cambia_esto_por_una_clave_larga

# Firma de las sesiones (mínimo 32 caracteres)
JWT_SECRET=cambia_esto_por_otra_clave_larga_de_64_caracteres
JWT_EXPIRA=12h

# Primer administrador (se crea al correr el seed). Contraseña de mínimo 10 caracteres.
ADMIN_NOMBRE=Administrador
ADMIN_USUARIO=admin
ADMIN_CORREO=sistemas@tuempresa.com
ADMIN_PASSWORD=cambia_esta_clave

# Orígenes permitidos para llamar la API desde otro dominio (separados por coma). Vacío = mismo dominio.
CORS_ORIGEN=

# Documentación interactiva en /api/docs (pon false cuando ya no la necesites)
SWAGGER=true

TZ=America/Mexico_City
